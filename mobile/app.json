{
  "expo": {
    "name": "Pantriful",
    "slug": "pantriful",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pantriful",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pantriful.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.pantriful.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.738084053265-4u0snai9ubmjo3m7fc0mplkjp6md9pr6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pantriful uses your camera to identify pantry items from a photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "738084053265-rh8s0phl80ti1h07ht2585cf8ej1m738.apps.googleusercontent.com",
      "googleIosClientId": "738084053265-4u0snai9ubmjo3m7fc0mplkjp6md9pr6.apps.googleusercontent.com",
      "apiBaseUrl": "http://localhost:8080",
      "router": {},
      "eas": {
        "projectId": "4a94f283-2290-4392-abc2-f91febb3a271"
      }
    },
    "owner": "afnanh1320"
  }
}
